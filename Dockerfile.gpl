
FROM python:3.10-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app/gpl

RUN apt-get update && \
    apt-get install -y \
        build-essential \
        git \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip

# Instalar PyTorch CPU
RUN pip install torch==2.2.2 \
    --index-url https://download.pytorch.org/whl/cpu

COPY requirements-gpl.txt /tmp/requirements-gpl.txt

RUN pip install -r /tmp/requirements-gpl.txt

# Instalar GPL sin alterar dependencias
COPY gpl/ /app/gpl/
RUN pip install --no-deps -e /app/gpl

CMD ["bash"]
